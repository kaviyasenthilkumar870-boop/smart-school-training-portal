# Smart School Training Portal - Environment Configuration
PORT=5050
NODE_ENV=development

# MongoDB Connection String (MongoDB Community Server local or MongoDB Atlas Cloud)
# Example Local: mongodb://127.0.0.1:27017/smart_school
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_school?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_school

# JWT Secret for signing secure authentication tokens
JWT_SECRET=smart_school_super_secret_jwt_key_2026_education
JWT_EXPIRES_IN=7d
